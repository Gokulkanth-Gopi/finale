# =============================================================================
# ZYNCWEB SOLUTIONS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env.local` for local development.
# Set these variables in your deployment platform (Vercel, Railway, etc.).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. RESEND EMAIL CONFIGURATION (Server-Side Secrets)
# -----------------------------------------------------------------------------
# Obtain your API key from: https://resend.com/api-keys
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"

# Recipient email where contact form submissions will be sent.
# Default: info@zyncweb.dev
# NOTE FOR RESEND TESTING: When using the unverified test sender (onboarding@resend.dev),
# Resend requires that this TO email matches your registered Resend account email address.
# Once your custom domain (zyncweb.dev) is verified on Resend, set this to info@zyncweb.dev.
CONTACT_TO_EMAIL="info@zyncweb.dev"

# Verified sender email address.
# - During initial testing without domain verification:
#   CONTACT_FROM_EMAIL="ZyncWeb Contact Form <onboarding@resend.dev>"
# - In production (after verifying zyncweb.dev in Resend):
#   CONTACT_FROM_EMAIL="ZyncWeb Contact <notifications@zyncweb.dev>"
CONTACT_FROM_EMAIL="ZyncWeb Contact Form <onboarding@resend.dev>"

# -----------------------------------------------------------------------------
# 2. MAKE.COM WEBHOOK INTEGRATION (Optional & Decoupled)
# -----------------------------------------------------------------------------
# Make.com scenario webhook URL for CRM, spreadsheet, or workflow automation.
# Form submissions will be sent to this endpoint via server-side POST.
# If Make is down or fails, direct email delivery and WhatsApp will continue uninterrupted.
MAKE_WEBHOOK_URL="https://hook.eu1.make.com/quqgrmkw7t6ghl54ojbjq05hhb9g11e0"

# Set to "true" to skip Make webhook dispatch entirely (e.g. during local tests)
DISABLE_MAKE_WEBHOOK="false"

# -----------------------------------------------------------------------------
# 3. APPLICATION & AI CONFIGURATION
# -----------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
NEXT_PUBLIC_APP_URL="https://zyncweb.dev"
